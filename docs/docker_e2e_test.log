-- [4] agent 修复 -> docker exec python 做 str_replace --
$ docker exec sweforge-task-toy_cache_al-22c3d6c4 /bin/sh -c <<'SHELL'
    python3 - <<'PYEOF'
    import pathlib
    p = pathlib.Path('/workspace/toy_cache/cache.py')
    s = p.read_text()
    old = '    value = compute()\n    if value not in _CACHE:\n        _CACHE[value] = value\n    return _CACHE[value]\n'
    new = '    if key not in _CACHE:\n        _CACHE[key] = compute()\n    return _CACHE[key]\n'
    n = s.count(old)
    if n == 1:
        p.write_text(s.replace(old, new))
        print('str_replace: 1 occurrence replaced -> cache keyed by key, not value')
    elif n == 0:
        print('str_replace: already applied (0 occurrences)')
    else:
        raise AssertionError(f'expected at most 1 occurrence, got {n}')
